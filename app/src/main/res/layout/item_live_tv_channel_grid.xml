<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/live_tv_channel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:foreground="@drawable/outline_drawable"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="6dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="84dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/primaryGrayBackground">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/live_tv_channel_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/live_tv_channel_logo_desc"
                tools:ignore="ContentDescription"
                android:src="@drawable/ic_live_tv_placeholder" />

            <View
                android:id="@+id/live_tv_channel_playing_indicator"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/live_tv_dot_indicator"
                android:visibility="invisible" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/live_tv_channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="?attr/textColor"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Channel Name" />

    <TextView
        android:id="@+id/live_tv_channel_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="?attr/grayTextColor"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="News"
        tools:visibility="visible" />

</LinearLayout>
