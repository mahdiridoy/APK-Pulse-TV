<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <WebView
        android:id="@+id/splash_ad_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fully transparent overlay that absorbs every touch so the ad below is view-only. -->
    <View
        android:id="@+id/splash_touch_blocker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false" />

    <TextView
        android:id="@+id/splash_please_wait"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="@drawable/live_tv_osd_background"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="@string/splash_please_wait"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

</FrameLayout>
