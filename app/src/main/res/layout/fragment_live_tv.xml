<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/live_tv_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryGrayBackground"
    tools:context=".ui.livetv.LiveTvFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/primaryGrayBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/title_live_tv"
                    android:textColor="?attr/textColor"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/live_tv_refresh_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/live_tv_refreshing"
                    android:focusable="true"
                    android:nextFocusDown="@id/live_tv_channel_list"
                    android:nextFocusLeft="@id/nav_rail_view"
                    android:nextFocusRight="@id/live_tv_search_button"
                    android:padding="8dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="?attr/white" />

                <ImageButton
                    android:id="@+id/live_tv_search_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/title_search"
                    android:focusable="true"
                    android:nextFocusDown="@id/live_tv_channel_list"
                    android:nextFocusLeft="@id/live_tv_refresh_button"
                    android:padding="8dp"
                    android:src="@drawable/search_icon"
                    app:tint="?attr/white" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/live_tv_swipe_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/live_tv_channel_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp"
                    android:focusable="false"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusLeft="@id/nav_rail_view"
                    android:nextFocusUp="@id/live_tv_search_button"
                    tools:listitem="@layout/item_live_tv_channel" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <ProgressBar
                android:id="@+id/live_tv_list_loading"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/live_tv_list_error_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/live_tv_list_error_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="?attr/textColor"
                    android:textSize="15sp"
                    tools:text="@string/live_tv_no_channels" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/live_tv_list_retry_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:focusable="true"
                    android:text="@string/live_tv_retry" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Narrow right-edge strip: swipe left here to open the search panel (list content sits
         underneath and would otherwise consume the touch before an edge-swipe gesture could). -->
    <View
        android:id="@+id/live_tv_open_search_edge"
        android:layout_width="18dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:contentDescription="@string/title_search" />

    <!-- Scrim shown behind the search panel on phones so an outside tap closes it -->
    <View
        android:id="@+id/live_tv_search_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <!-- Right side slide-in channel search panel -->
    <FrameLayout
        android:id="@+id/live_tv_search_panel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="?attr/primaryGrayBackground"
        android:elevation="8dp"
        android:translationX="300dp"
        android:visibility="invisible"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <EditText
                    android:id="@+id/live_tv_search_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/live_tv_search_hint"
                    android:focusable="true"
                    android:nextFocusDown="@id/live_tv_search_results"
                    android:nextFocusRight="@id/live_tv_search_close"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="?attr/textColor"
                    android:textColorHint="?attr/grayTextColor" />

                <ImageView
                    android:id="@+id/live_tv_search_close"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusDown="@id/live_tv_search_results"
                    android:nextFocusLeft="@id/live_tv_search_input"
                    android:padding="4dp"
                    android:contentDescription="@string/live_tv_close_search_desc"
                    android:src="@drawable/ic_baseline_close_24"
                    app:tint="?attr/textColor" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/grayTextColor"
                android:alpha="0.2" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/live_tv_search_results"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:nextFocusUp="@id/live_tv_search_input"
                tools:listitem="@layout/item_live_tv_channel" />

            <TextView
                android:id="@+id/live_tv_search_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/live_tv_search_no_results"
                android:textColor="?attr/grayTextColor"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Narrow left-edge strip dedicated to the swipe-left-to-close gesture, kept separate
             from the EditText/RecyclerView above so their own touch handling isn't stolen. -->
        <View
            android:id="@+id/live_tv_search_drag_handle"
            android:layout_width="18dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?attr/grayTextColor"
            android:alpha="0.15"
            android:contentDescription="@string/live_tv_close_search_desc" />
    </FrameLayout>

</FrameLayout>
