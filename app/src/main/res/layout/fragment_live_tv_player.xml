<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/live_tv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".ui.livetv.LiveTvPlayerFragment">

    <androidx.media3.ui.PlayerView
        android:id="@+id/live_tv_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:focusable="false"
        app:backgroundTint="@android:color/black"
        app:resize_mode="fit"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <!-- Transparent overlay that owns all touch gestures for the live tv screen -->
    <View
        android:id="@+id/live_tv_gesture_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false" />

    <!-- Top scrim + back button + current channel info + resolution selector, auto-fades -->
    <LinearLayout
        android:id="@+id/live_tv_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/live_tv_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/live_tv_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/go_back_img_des"
            android:padding="8dp"
            android:src="@drawable/go_back_30"
            app:tint="@android:color/white" />

        <ImageView
            android:id="@+id/live_tv_top_bar_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/live_tv_channel_logo_desc"
            android:src="@drawable/ic_live_tv_placeholder" />

        <TextView
            android:id="@+id/live_tv_top_bar_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Channel Name" />

        <ImageButton
            android:id="@+id/live_tv_resolution_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/live_tv_resolution_title"
            android:padding="8dp"
            android:src="@drawable/ic_baseline_hd_24"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Center OSD for channel switch / volume / brightness / resolution feedback -->
    <LinearLayout
        android:id="@+id/live_tv_osd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/live_tv_osd_background"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/live_tv_osd_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_live_tv_placeholder" />

        <TextView
            android:id="@+id/live_tv_osd_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxWidth="220dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Channel Name" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/live_tv_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/live_tv_error_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/live_tv_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            tools:text="@string/live_tv_no_channels" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/live_tv_retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:text="@string/live_tv_retry" />
    </LinearLayout>

    <!-- Bottom-right quality indicator — shows current resolution + bitrate -->
    <TextView
        android:id="@+id/live_tv_quality_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/live_tv_osd_background"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="1080p • 4.2 Mbps" />

</FrameLayout>
